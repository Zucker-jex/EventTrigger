        <button name="addDelivery" x="12"  w="126" h="28" text="Set Delivery Pt"/>
        <button name="add"         x="146" w="110" h="28" text="Add Trigger"/>
        <button name="deleteAll"   x="264" w="100" h="28" text="Delete All"/>
        <button name="refresh"     x="372" w="70"  h="28" text="Refresh"/>
        <button name="showAll"     x="450" w="90"  h="28" text="Show All"/>
    </footer>
    <row height="30" buttonH="22">
        <button name="edit"    w="40" text="Edit"/>
        <button name="delete"  w="24" text="X"/>
        <button name="reset"   w="24" text="R"/>
        <button name="history" w="40" text="Hist"/>
    </row>
</EventTriggerLayout>
