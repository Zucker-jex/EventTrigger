<EventTriggerLayout version="2.0">
    <window x="0" y="0" w="1020" h="560"/>
    <titleBar height="28">
        <label name="title" x="510" y="7" w="0" h="0" text="EventTrigger Manager" center="true"/>
        <button name="close" x="995" y="4" w="21" h="21" text="X"/>
    </titleBar>
    <header y="34" height="18">
        <col name="index"     x="10"  w="40"  text="#"/>
        <col name="position"  x="54"  w="150" text="Position"/>
        <col name="message"   x="208" w="250" text="Message"/>
        <col name="detail"    x="462" w="200" text="Delay/Range/Output"/>
        <col name="creator"   x="666" w="100" text="Creator"/>
        <col name="triggered" x="770" w="84"  text="Triggered"/>
        <col name="actions"   x="858" w="152" text="Actions"/>
    </header>
    <list x="10" y="54" w="1000" h="440"/>
